{
  "name": "Liga Portugal - Tema Power BI",
  "dataColors": ["#A970FF", "#7A6D92", "#FF4FA3", "#D4B8FF", "#5CF2A6", "#FF6B7A", "#8E6BD8", "#FF8CC6"],
  "foreground": "#ECE6F7",
  "foregroundNeutralSecondary": "#A99CC2",
  "foregroundNeutralTertiary": "#6F6385",
  "background": "#1D1330",
  "backgroundLight": "#2E2148",
  "backgroundNeutral": "#3A2C57",
  "tableAccent": "#D4B8FF",
  "good": "#5CF2A6",
  "neutral": "#A99CC2",
  "bad": "#FF6B7A",
  "maximum": "#D4B8FF",
  "center": "#A970FF",
  "minimum": "#2E2148",
  "null": "#3A2C57",
  "textClasses": {
    "callout": {"fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#D4B8FF"},
    "title":   {"fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#ECE6F7"},
    "header":  {"fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#ECE6F7"},
    "label":   {"fontSize": 10, "fontFace": "Segoe UI", "color": "#A99CC2"}
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{"color": {"solid": {"color": "#120B1F"}}, "transparency": 0}],
        "outspace": [{"color": {"solid": {"color": "#0B0614"}}, "transparency": 0}]
      }
    },
    "*": {
      "*": {
        "background": [{"show": true, "color": {"solid": {"color": "#1D1330"}}, "transparency": 0}],
        "border": [{"show": true, "color": {"solid": {"color": "#2E2148"}}, "radius": 10}],
        "title": [{"fontColor": {"solid": {"color": "#ECE6F7"}}}]
      }
    }
  }
}